{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/api-bundle.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test:fase5": "tsx e2e_fase5.ts",
    "test:grounding": "tsx server/grounding_phase2_tests.ts",
    "test:research-contracts": "tsx server/research_contract_tests.ts",
    "test:research-retrieval": "tsx server/research_retrieval_tests.ts",
    "test:phase3c": "tsx server/phase3c_tests.ts",
    "test:phase3c-integration": "tsx server/phase3c_integration_tests.ts",
    "test:phase3d": "tsx server/phase3d_tests.ts",
    "test:phase3e": "tsx server/phase3e_tests.ts",
    "test:phase4": "tsx server/phase4_0_tests.ts",
    "test:phase4.1": "tsx server/phase4_1_e2e_tests.ts",
    "test:phase6": "tsx server/phase6_tests.ts",
    "test:phase8": "tsx server/phase8_tests.ts",
    "test:r2-production": "tsx server/patch_6_r2_production_tests.ts",
    "test:r2-fixture": "tsx server/r2_fixture_engineering.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "push": "git add . && git commit -m \"update\" && git push origin main"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "@supabase/supabase-js": "^2.114.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
