# -----------------------------------------------------------------------------
# AI CINEMATIC PRODUCTION STUDIO - ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# 1. AI PROVIDER KEYS (server-only; never expose service keys in VITE_* variables)
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GLADIA_API_KEY=""

# 2. SUPABASE PRODUCTION DATABASE (service role key is server-only)
SUPABASE_ENABLED="false"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. APP URL (REQUIRED for OAuth Callbacks & Google Drive Export/Import)
# Production Vercel domain or http://localhost:3000
APP_URL="https://your-app-name.vercel.app"

# 4. RUNTIME AND COMPATIBILITY FLAGS
NODE_ENV="development"
FORCE_LOCAL_DB="false"
USE_FIRESTORE="false"

# 5. FIREBASE FIRESTORE CONFIGURATION (OPTIONAL compatibility backend)
# If left empty, Supabase/local fallback is used.
FIREBASE_PROJECT_ID="nupress-bc617"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@nupress-bc617.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=""

